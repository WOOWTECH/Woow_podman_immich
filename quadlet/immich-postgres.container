# immich-postgres.container: PostgreSQL 14 with VectorChord and pgvecto.rs, the database
# Immich requires.
#
# The data directory comes from HOST_POSTGRES_DIR in ~/.config/immich/immich.env and is
# rendered in at install time (decision D2). It must be on a local filesystem: a network
# share (NFS, SMB) corrupts a Postgres cluster. scripts/install.sh checks that.
# The password is the podman secret immich-db-password; initdb reads it only on an empty
# directory, so an adopted cluster keeps the password it already has.
[Unit]
Description=Immich PostgreSQL
Documentation=https://github.com/WOOWTECH/Woow_podman_immich
PartOf=immich.target

[Container]
ContainerName=immich_postgres
# Tag and digest of upstream Immich v2.7.5's docker-compose.yml.
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
Network=immich.network:alias=database
Volume=@@HOST_POSTGRES_DIR@@:/var/lib/postgresql/data
ShmSize=128m
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Secret=immich-db-password,type=env,target=POSTGRES_PASSWORD
Label=io.woowtech.app=immich
LogDriver=journald
HealthCmd=pg_isready -d immich -U postgres
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=60s
# Quadlet 4.9.3 has no StopTimeout= key; the generated ExecStop (podman rm -f) honours this.
PodmanArgs=--stop-timeout=60

[Service]
# A container stopped by systemd is stopped with SIGTERM: an entrypoint that does not
# trap it exits 143 (128+15), which would leave the unit failed after a clean stop.
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=default.target
