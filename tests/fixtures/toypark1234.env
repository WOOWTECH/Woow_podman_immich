# What scripts/migrate-legacy.sh writes on toypark1234: the library and the Postgres
# directory stay where the podman-compose deployment put them (inside the old checkout;
# they move to ~/.local/share/immich after the soak period), and the publish moves from
# 0.0.0.0 to loopback because the Cloudflare tunnel reaches it at localhost:2283.
HOST_BIND=127.0.0.1
HOST_PORT=2283
HOST_LIBRARY_DIR=%h/Woow_immich_docker_compose_all/library
HOST_POSTGRES_DIR=%h/Woow_immich_docker_compose_all/postgres
TZ=Asia/Taipei
IMMICH_MACHINE_LEARNING_ENABLED=true
