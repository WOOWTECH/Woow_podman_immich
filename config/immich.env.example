# ~/.config/immich/immich.env: the per-host settings of this Immich install (mode 0600).
# scripts/install.sh creates it from config/immich.env.example and reads it on every run.
# Format: KEY=value lines only. No quotes, no "export", no "# comment" after a value.
#
# Two kinds of keys live here:
#   HOST_*   rendered into the unit files by scripts/install.sh (run it again after a change)
#   the rest passed to the server and machine-learning containers with --env-file, so any
#            Immich environment variable works
# The database password is not here: install.sh creates the podman secret
# immich-db-password. Do not set IMMICH_PORT: that is Immich's port inside the container.

# ---- Host side (rendered into the units) ---------------------------------------------
# Publish address. Keep 127.0.0.1 when a Cloudflare tunnel or NPM on this host is the way
# in; 0.0.0.0 also serves the LAN and the mobile app directly.
HOST_BIND=127.0.0.1
HOST_PORT=2283

# Photos and videos (mounted at /data). Point this at an existing library to adopt it.
# %h is your home directory. Make sure the filesystem is large enough.
HOST_LIBRARY_DIR=%h/.local/share/immich/library

# PostgreSQL data. LOCAL DISK ONLY: a Postgres cluster on NFS or SMB will be corrupted.
HOST_POSTGRES_DIR=%h/.local/share/immich/postgres

# ---- Container side (Immich) -----------------------------------------------------------
TZ=Asia/Taipei
# false when the machine-learning container is not installed (install.sh --no-ml sets it).
IMMICH_MACHINE_LEARNING_ENABLED=true
# IMMICH_LOG_LEVEL=log
# MACHINE_LEARNING_WORKERS=1
# MACHINE_LEARNING_MODEL_TTL=300
